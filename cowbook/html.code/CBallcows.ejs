<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cowbook</title>
</head>
<body>
    <%- include("CBheader.ejs") %>
    <br>
    <br>
    <br>
    <br>
    <% for(let i =0;i<data.length;i++ ){%>
        <p><%= i+1 %>. serial no = <%=data[i].id%>, DOB = <%=data[i].dob%>, lactations = <%=data[i].lactations%>, inseminated = <%=data[i].inseminated%>
            <%if(data[i].doi){%>
            , DOI = <%=data[i].doi%> 
            <%} %>
            </p>
    <%}%>
    
</body>
</html>