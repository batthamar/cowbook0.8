<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cowbook</title>
    <link rel="stylesheet" href="../css.code/index.css">
</head>
<body>
    <%- include("CBheader.ejs") %>

    <div class="main-content">
        
        <span style="font-size: 75px;">Cowbook</span>
        <br>
        <br>
        <div class="Profile"> 
